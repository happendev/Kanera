{
  "name": "@kanera/admin-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "assets:generate": "node scripts/sync-styles.mjs && node scripts/generate-tabler-webfont-css.mjs",
    "prestart": "pnpm assets:generate",
    "start": "ng serve --port 4300 --host 0.0.0.0 --proxy-config proxy.conf.json",
    "prebuild": "pnpm assets:generate",
    "build": "ng build",
    "prelint": "pnpm assets:generate",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src"
  },
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@kanera/shared": "workspace:*",
    "@tabler/icons-webfont": "3.49.0",
    "chart.js": "^4.6.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
