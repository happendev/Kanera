{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "k",
      "i18n": {
        "sourceLocale": "en-GB"
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init"],
            "deployUrl": "/",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "favicon.ico",
                "input": "public/assets/favicon",
                "output": "/"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/opsz.css",
              "src/tabler-icons.generated.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "markdown-it-task-lists"
            ]
          },
          "configurations": {
            "production": {
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kb",
                  "maximumError": "1100kb"
                },
                {
                  "type": "anyScript",
                  "maximumWarning": "1050kb",
                  "maximumError": "1250kb"
                }
              ],
              "outputHashing": "all",
              "namedChunks": true
            },
            "push-https": {
              "serviceWorker": "ngsw-config.json",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            },
            "push-https": {
              "buildTarget": "web:build:push-https"
            },
            "e2e": {
              "buildTarget": "web:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "web:build:development",
            "format": "json",
            "outputPath": "src/locale",
            "outFile": "messages.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": ["src/test-setup.ts"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
