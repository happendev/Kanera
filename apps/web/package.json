{
  "name": "@kanera/web",
  "version": "1.10.0",
  "private": true,
  "scripts": {
    "icons:generate": "node scripts/generate-tabler-icons.mjs",
    "icons:css": "node scripts/generate-tabler-webfont-css.mjs",
    "emoji:generate": "node scripts/generate-emoji-catalog.mjs",
    "assets:generate": "node scripts/generate-pwa-manifests.mjs && pnpm icons:generate && pnpm icons:css && pnpm emoji:generate",
    "prestart": "node scripts/write-build-info.mjs && pnpm assets:generate",
    "prestart:https": "node scripts/write-build-info.mjs && pnpm assets:generate",
    "start": "ng serve --port 4200 --host 0.0.0.0 --proxy-config proxy.https.conf.json",
    "start:https": "ng serve --configuration push-https --port 4200 --host 0.0.0.0 --ssl --ssl-cert ../../.certs/localhost.pem --ssl-key ../../.certs/localhost-key.pem --proxy-config proxy.https.conf.json",
    "prebuild": "node scripts/write-build-info.mjs && pnpm assets:generate",
    "build": "ng build --configuration production --stats-json && node scripts/report-bundle.mjs --check && node scripts/precompress.mjs",
    "bundle:report": "node scripts/report-bundle.mjs",
    "bundle:analyze": "ng build --configuration production --stats-json && pnpm bundle:report",
    "bundle:check": "pnpm build",
    "prelint": "node scripts/write-build-info.mjs && pnpm assets:generate",
    "test": "node scripts/test.mjs",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src && node scripts/check-accent-stripes.mjs && node scripts/i18n.mjs check",
    "i18n:extract": "node scripts/i18n.mjs extract",
    "i18n:check": "node scripts/i18n.mjs check",
    "templates:messages": "node scripts/generate-template-messages.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/localize": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/service-worker": "^22.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@kanera/shared": "workspace:*",
    "@stripe/stripe-js": "^9.13.0",
    "@tabler/icons-webfont": "3.49.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-emoji": "3.31.4",
    "@tiptap/extension-horizontal-rule": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "blobatar": "^2.7.0",
    "dompurify": "^3.4.16",
    "idb": "^8.0.3",
    "marked": "^18.1.0",
    "posthog-js": "^1.422.5",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.4",
    "tiptap-markdown": "^0.9.0",
    "tslib": "^2.8.1",
    "uqr": "^0.1.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@types/node": "^24.13.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.11",
    "zone.js": "~0.16.2"
  }
}
