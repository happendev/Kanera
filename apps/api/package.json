{
  "name": "@kanera/api",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker-index.ts",
    "dev:public-api": "tsx watch src/public-api-index.ts",
    "dev:admin-api": "tsx watch src/admin-index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "start:migrate": "pnpm db:migrate && pnpm start",
    "start:worker": "tsx src/worker-index.ts",
    "start:public-api": "tsx src/public-api-index.ts",
    "start:admin-api": "tsx src/admin-index.ts",
    "test": "node scripts/run-unit-tests.mjs",
    "test:integration": "bash ../../scripts/test-api-integration.sh",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:hosted-accounts": "tsx src/scripts/seed-hosted-accounts.ts",
    "db:seed:web-performance": "tsx src/scripts/seed-web-performance.ts",
    "db:studio": "drizzle-kit studio",
    "email:preview": "tsx src/scripts/generate-email-previews.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.7",
    "@fastify/request-context": "^7.0.5",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@kanera/shared": "workspace:*",
    "@prometheus-io/client": "^0.16.1",
    "@scalar/fastify-api-reference": "^1.76.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.11.1",
    "openapi-types": "^12.1.3",
    "otpauth": "^9.6.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "posthog-node": "^5.63.1",
    "rate-limiter-flexible": "^11.2.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "22.2.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "typescript": "~5.9.3"
  }
}
