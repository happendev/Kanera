{
  "version": 1,
  "cases": [
    {
      "id": "active-work-by-person",
      "category": "direct",
      "prompt": "List Ben Ortega's active assigned work in the Marketing & Creative workspace.",
      "expectedTools": ["kanera_list_workspace_members", "kanera_query_work_cards"],
      "expectedArguments": {
        "kanera_query_work_cards": {
          "lens": "team",
          "scope": "workspaceId resolved from Marketing & Creative",
          "filters": "assigneeIds contains Ben's resolved userId and completion is active"
        }
      },
      "forbiddenTools": []
    },
    {
      "id": "history-by-person",
      "category": "direct",
      "prompt": "What work did Ben Ortega perform across Marketing & Creative last month?",
      "expectedTools": ["kanera_list_workspace_members", "kanera_query_work_history"],
      "expectedArguments": {
        "kanera_query_work_history": {
          "userId": "Ben's resolved userId",
          "scope": "Marketing & Creative workspaceId",
          "preset": "last_month"
        }
      },
      "forbiddenTools": ["kanera_list_activity"]
    },
    {
