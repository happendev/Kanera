{
  "version": 2,
  "cases": [
    {
      "id": "update-card-by-human-key",
      "category": "direct",
      "prompt": "Update DEV-938 with the investigation findings and agreed implementation plan.",
      "expectedTools": ["kanera_get_card", "kanera_update_card"],
      "expectedArguments": {
        "kanera_get_card": {
          "cardId": "DEV-938"
        },
        "kanera_update_card": {
          "cardId": "DEV-938",
          "changes": "the requested investigation findings and implementation plan"
        }
      },
      "forbiddenTools": ["kanera_search"],
      "forbiddenCapabilities": ["browser", "computer-use"]
    },
    {
      "id": "active-work-by-person",
      "category": "direct",
      "prompt": "List Ben Ortega's active assigned work in the Marketing & Creative workspace.",
      "expectedTools": ["kanera_list_workspace_members", "kanera_query_work_cards"],
      "expectedArguments": {
        "kanera_query_work_cards": {
          "lens": "team",
          "scope": "workspaceId resolved from Marketing & Creative",
          "filters": "assigneeIds contains Ben's resolved userId and completion is active"
        }
      },
      "forbiddenTools": []
    },
    {
      "id": "history-by-person",
      "category": "direct",
      "prompt": "What work did Ben Ortega perform across Marketing & Creative last month?",
      "expectedTools": ["kanera_list_workspace_members", "kanera_query_work_history"],
      "expectedArguments": {
        "kanera_query_work_history": {
          "userId": "Ben's resolved userId",
          "scope": "Marketing & Creative workspaceId",
          "preset": "last_month"
        }
      },
      "forbiddenTools": ["kanera_list_activity"]
    },
    {
      "id": "monthly-one-on-one",
      "category": "indirect",
      "prompt": "Prepare my monthly one-on-one with Ben. Use Kanera, cite the relevant work, and do not change anything.",
      "expectedTools": [
        "kanera_list_workspace_members",
        "kanera_query_work_cards",
        "kanera_query_work_history",
        "kanera_search",
        "kanera_get_cards_content"
      ],
      "expectedArguments": {
        "kanera_query_work_cards": "separate active and completed queries for Ben",
        "kanera_query_work_history": "Ben as actor over the requested month"
      },
      "forbiddenTools": ["kanera_update_card", "kanera_add_comment"]
    },
    {
      "id": "live-content-search",
      "category": "direct",
      "prompt": "Find landing-page copy in cards, comments, notes, and attachment names.",
      "expectedTools": ["kanera_search"],
      "expectedArguments": {
        "kanera_search": {
          "query": "landing-page copy",
          "types": ["card", "comment", "note", "attachment"]
        }
      },
      "forbiddenTools": ["kanera_search_docs"]
    },
    {
      "id": "documentation-search",
      "category": "negative",
      "prompt": "How do Kanera board mirrors work?",
      "expectedTools": ["kanera_search_docs"],
      "expectedArguments": {},
      "forbiddenTools": ["kanera_search"]
    },
    {
      "id": "create-review-automation",
      "category": "direct",
      "prompt": "In Marketing & Creative, create and enable an automation so cards moved into Review & Approval are assigned to Amelia Hart and get a review due date two days later.",
      "expectedTools": [
        "kanera_get_workspace",
        "kanera_list_workspace_members",
        "kanera_create_automation"
      ],
      "expectedArguments": {
        "kanera_create_automation": {
          "enabled": true,
          "triggerType": "card_enters_list",
          "triggerListId": "Review & Approval list id",
          "applyOnCreate": false,
          "applyOnMove": true,
          "actions": "add_assignees with Amelia's userId, then set_due_date with offsetDays 2"
        }
      },
      "forbiddenTools": ["kanera_update_card"]
    },
    {
      "id": "unsupported-workspace-delete",
      "category": "negative",
      "prompt": "Delete the Marketing & Creative workspace.",
      "expectedTools": [],
      "expectedArguments": {},
      "forbiddenTools": ["kanera_update_card", "kanera_archive_card"]
    }
  ]
}
