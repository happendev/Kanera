{
  "version": 2,
  "cases": [
    {
      "id": "update-card-by-human-key",
      "category": "direct",
      "prompt": "Update DEV-938 with the investigation findings and agreed implementation plan.",
      "expectedTools": [
        "cards.get",
        "cards.update"
      ],
      "expectedArguments": {
        "cards.get": {
          "cardId": "DEV-938"
        },
        "cards.update": {
          "cardId": "DEV-938",
          "changes": "the requested investigation findings and implementation plan"
        }
      },
      "forbiddenTools": [
        "search.content"
      ],
      "forbiddenCapabilities": [
        "browser",
        "computer-use"
      ]
    },
    {
      "id": "active-work-by-person",
      "category": "direct",
      "prompt": "List Ben Ortega's active assigned work in the Marketing & Creative workspace.",
      "expectedTools": [
        "workspaces.list_members",
        "work.query_cards"
      ],
      "expectedArguments": {
        "work.query_cards": {
          "lens": "team",
          "scope": "workspaceId resolved from Marketing & Creative",
          "filters": "assigneeIds contains Ben's resolved userId and completion is active"
        }
      },
      "forbiddenTools": []
    },
    {
      "id": "history-by-person",
      "category": "direct",
      "prompt": "What work did Ben Ortega perform across Marketing & Creative last month?",
      "expectedTools": [
        "workspaces.list_members",
        "work.query_history"
      ],
      "expectedArguments": {
        "work.query_history": {
          "userId": "Ben's resolved userId",
          "scope": "Marketing & Creative workspaceId",
          "preset": "last_month"
        }
      },
      "forbiddenTools": [
        "activity.list"
      ]
    },
    {
      "id": "monthly-one-on-one",
      "category": "indirect",
      "prompt": "Prepare my monthly one-on-one with Ben. Use Kanera, cite the relevant work, and do not change anything.",
      "expectedTools": [
        "workspaces.list_members",
        "work.query_cards",
        "work.query_history",
        "search.content",
        "cards.get_content"
      ],
      "expectedArguments": {
        "work.query_cards": "separate active and completed queries for Ben",
        "work.query_history": "Ben as actor over the requested month"
      },
      "forbiddenTools": [
        "cards.update",
        "comments.add"
      ]
    },
    {
      "id": "live-content-search",
      "category": "direct",
      "prompt": "Find landing-page copy in cards, comments, notes, and attachment names.",
      "expectedTools": [
        "search.content"
      ],
      "expectedArguments": {
        "search.content": {
          "query": "landing-page copy",
          "types": [
            "card",
            "comment",
            "note",
            "attachment"
          ]
        }
      },
      "forbiddenTools": [
        "search.docs"
      ]
    },
    {
      "id": "documentation-search",
      "category": "negative",
      "prompt": "How do Kanera board mirrors work?",
      "expectedTools": [
        "search.docs"
      ],
      "expectedArguments": {},
      "forbiddenTools": [
        "search.content"
      ]
    },
    {
      "id": "create-review-automation",
      "category": "direct",
      "prompt": "In Marketing & Creative, create and enable an automation so cards moved into Review & Approval are assigned to Amelia Hart and get a review due date two days later.",
      "expectedTools": [
        "workspaces.get",
        "workspaces.list_members",
        "automations.create"
      ],
      "expectedArguments": {
        "automations.create": {
          "enabled": true,
          "triggerType": "card_enters_list",
          "triggerListId": "Review & Approval list id",
          "applyOnCreate": false,
          "applyOnMove": true,
          "actions": "add_assignees with Amelia's userId, then set_due_date with offsetDays 2"
        }
      },
      "forbiddenTools": [
        "cards.update"
      ]
    },
    {
      "id": "create-marketing-workspace-from-template",
      "category": "direct",
      "prompt": "Set up a new Marketing workspace in Kanera using the marketing template.",
      "expectedTools": [
        "workspaces.list_templates",
        "workspaces.create"
      ],
      "expectedArguments": {
        "workspaces.create": {
          "name": "Marketing",
          "templateId": "marketing"
        }
      },
      "forbiddenTools": [
        "boards.create_standalone",
        "boards.create"
      ],
      "forbiddenCapabilities": [
        "browser",
        "computer-use"
      ]
    },
    {
      "id": "create-personal-standalone-board",
      "category": "direct",
      "prompt": "Make me a simple standalone to-do board called Reading list.",
      "expectedTools": [
        "boards.create_standalone"
      ],
      "expectedArguments": {
        "boards.create_standalone": {
          "name": "Reading list",
          "templateId": "simple-todo"
        }
      },
      "forbiddenTools": [
        "workspaces.create",
        "boards.create"
      ]
    },
    {
      "id": "add-board-to-existing-workspace",
      "category": "direct",
      "prompt": "Add a Q4 launch board to the Marketing & Creative workspace.",
      "expectedTools": [
        "workspaces.list",
        "boards.create"
      ],
      "expectedArguments": {
        "boards.create": {
          "workspaceId": "Marketing & Creative workspaceId",
          "name": "Q4 launch"
        }
      },
      "forbiddenTools": [
        "workspaces.create",
        "boards.create_standalone"
      ]
    },
    {
      "id": "unsupported-workspace-delete",
      "category": "negative",
      "prompt": "Delete the Marketing & Creative workspace.",
      "expectedTools": [],
      "expectedArguments": {},
      "forbiddenTools": [
        "cards.update",
        "cards.archive"
      ]
    }
  ]
}
