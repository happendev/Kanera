{
  "name": "@kanera/mcp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "start": "tsx src/http.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src --ignore-pattern 'src/**/*.itest.ts'",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "bash ../../scripts/test-mcp-integration.sh"
  },
  "dependencies": {
    "@kanera/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prometheus-io/client": "^0.16.1",
    "ioredis": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
