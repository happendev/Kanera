{
  "name": "@kanera/mcp",
  "version": "4.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "start": "tsx src/http.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src --ignore-pattern 'src/**/*.itest.ts'",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "bash ../../scripts/test-mcp-integration.sh"
  },
  "dependencies": {
    "@kanera/shared": "workspace:*",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@prometheus-io/client": "^0.16.1",
    "ioredis": "^5.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
