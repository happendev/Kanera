{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // DOM is included for fetch/Request/Response/crypto.subtle: the SDK targets browsers, Workers,
    // and Deno as well as Node, so it must not depend on Node-only globals.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*.ts"]
}
